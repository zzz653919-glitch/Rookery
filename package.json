{
  "name": "rookery-chess-academy",
  "version": "1.0.0",
  "description": "Offline-first chess learning website: placement test, lessons, puzzles and a built-in computer opponent.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "precache": "node scripts/gen-precache.mjs",
    "test": "node --test tests/*.test.mjs",
    "selfplay": "node scripts/selfplay.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "puzzles": "node scripts/build-puzzles.mjs",
    "icons": "node scripts/make-icons.mjs",
    "start:static": "node scripts/serve.mjs",
    "db:migrate": "node --disable-warning=ExperimentalWarning server/cli.mjs migrate",
    "db:backup": "node --disable-warning=ExperimentalWarning server/cli.mjs backup",
    "admin:create": "node --disable-warning=ExperimentalWarning server/cli.mjs create-admin",
    "admin:reset-password": "node --disable-warning=ExperimentalWarning server/cli.mjs reset-password",
    "admin:list": "node --disable-warning=ExperimentalWarning server/cli.mjs list-admins"
  },
  "optionalDependencies": {
    "@libsql/client": "^0.18.0"
  }
}
